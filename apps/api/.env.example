NODE_ENV=development
PORT=4000

# Database — SQLite (zero-config) or PostgreSQL for production
DATABASE_URL=file:./dev.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careeros_ai

JWT_SECRET=replace-with-a-long-random-secret-min-24-chars
CLIENT_ORIGIN=http://localhost:8081

# ── AI Providers (add any/all you have) ──────────────────────────────────────
# The app tries each in order until one succeeds.
# Completely works offline with the built-in rule-based fallback.

# 1. Google Gemini — FREE tier available → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Groq — FREE, ultra-fast Llama 3.3 → https://console.groq.com
GROQ_API_KEY=

# 3. OpenAI — GPT-4o mini, pay-per-use → https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 4. Anthropic — Claude Haiku, pay-per-use → https://console.anthropic.com
ANTHROPIC_API_KEY=

# 5. Mistral — EU-hosted, pay-per-use → https://console.mistral.ai
MISTRAL_API_KEY=

# 6. Ollama — local, FREE, no internet needed → https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Optional integrations ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
