{
  "name": "careeros-ai",
  "version": "0.2.0",
  "private": true,
  "description": "CareerOS AI — Premium mobile-first personal career operating system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace apps/mobile run start --",
    "dev:api": "npm --workspace apps/api run dev",
    "lint": "npm --workspaces --if-present run lint",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "format": "prettier --write .",
    "db:generate": "npx prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "npm --workspace apps/api run prisma:migrate",
    "db:studio": "npx prisma studio --schema apps/api/prisma/schema.prisma",
    "db:reset": "npx prisma migrate reset --schema apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "@expo/cli": "^57.0.5",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  }
}
