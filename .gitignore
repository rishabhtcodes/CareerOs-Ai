apps/api/prisma/dev.db-shm
apps/api/prisma/dev.db-wal
*.db
*.db-journal
*.db-shm
*.db-wal

# ── Prisma generated client ───────────────────────────────────
# Keep migration history tracked — only exclude generated client
# apps/api/prisma/migrations/   ← intentionally tracked
apps/api/node_modules/

